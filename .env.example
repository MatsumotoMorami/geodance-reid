# Required for first boot. The deploy workflow writes these from repo secrets.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-at-least-8-chars

# Public ports on the server.
APP_PORT=13000
REID_PORT=18890

# Web -> Re-ID backend timeout. Nine RTSP cameras can take a long time on CPU.
REID_BACKEND_FETCH_MS=180000

# Default container Re-ID backend. Override only if you mount/provide other weights.
REID_EMBED_BACKEND=torchreid
TORCHREID_MODEL=osnet_ain_x1_0
TORCHREID_DEVICE=cpu
YOLO_DEVICE=cpu
YOLO_MODEL=yolov8n.pt
