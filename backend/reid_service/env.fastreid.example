# 复制为 .env 后按需修改（与 MODEL_ZOO 中 BoT(R50) 配置一致）
# https://github.com/JDAI-CV/fast-reid/blob/master/MODEL_ZOO.md
FASTREID_ROOT=/Users/你的用户名/Documents/Fast-ReID
FASTREID_CONFIG=/Users/你的用户名/Documents/Fast-ReID/configs/Market1501/bagtricks_R50.yml
FASTREID_WEIGHTS=/Users/你的用户名/Documents/Fast-ReID/weights/market_bot_R50.pth
FASTREID_DEVICE=cpu
YOLO_DEVICE=cpu
# YOLO：YOLO_WEIGHTS 指向本地 .pt 可跳过下载；否则用 weights/<YOLO_MODEL>，缺失时用 certifi 从 GitHub 拉取
# YOLO_MODEL=yolov8n.pt
# 低置信度仅画框（橙框）：YOLO_WEAK_BOXES=0 关闭；YOLO_WEAK_SHOW_MIN 低于 KEEP 的检出才画
# YOLO_WEAK_BOXES=1
# YOLO_WEAK_SHOW_MIN=0.06
# YOLO_WEAK_MIN_SIDE=16
# YOLO_CONF=0.08
# YOLO_IMGSZ=1280
# YOLO_MAX_SIDE=1600
# YOLO 同帧多人框 IoU 去重（进置信度过滤前）：YOLO_PERSON_NMS_IOU=0.5，YOLO_PERSON_NMS=0 关闭
# RTSP：FFmpeg stimeout（微秒），减轻 404/断流长时间阻塞
# RTSP_FFMPEG_STIMEOUT_US=7000000
# HEVC 花屏/灰块：默认每路持久连接 + 首开跳帧；若仍差可增大 RTSP_HEVC_OPEN_SKIP_FRAMES 或让相机更频繁发 I 帧
# RTSP_PERSISTENT_CAPTURE=1
# RTSP_HEVC_OPEN_SKIP_FRAMES=32
# RTSP_PERSISTENT_DRAIN_GRABS=6
# 若必须每次新连 RTSP（调试用）：RTSP_PERSISTENT_CAPTURE=0 且增大 RTSP_GRAB_DISCARD_FRAMES（如 40）
# RTSP_GRAB_DISCARD_FRAMES=18
# 抓帧：默认同路 RTSP 用 ffmpeg 抽 1 帧（nokey + 丢损坏），失败再回退 OpenCV 持久连接；显式 opencv 可关 ffmpeg
# RTSP_GRAB_BACKEND=ffmpeg
# RTSP_GRAB_BACKEND=opencv
# RTSP_FFMPEG_CLI_STIMEOUT_US=12000000
# RTSP_FFMPEG_CLI_DEADLINE_SEC=25
# RTSP_FFMPEG_SKIP_FRAME=nokey
# RTSP_FFMPEG_REJECT_CORRUPT=1
# 花屏仍判时多抓几次（Python）：RTSP_GRAB_CORRUPT_EXTRA_TRIES=4；预览只更新非花屏帧；REID_SKIP_YOLO_ON_CORRUPT_FRAME=1 可跳过该路 YOLO
# 花屏启发式（仅 OpenCV 路径重试）：RTSP_FRAME_MIN_STD、RTSP_FRAME_MIN_LAPLACIAN_VAR、RTSP_CORRUPT_RETRY_READS
# 视野重叠的两路：同一 Re-ID 只保留「前者」路上的框（后者去掉），多对用 | 分隔
# REID_OVERLAP_PAIRS=stairs_1,stairs_2|room,board_game
# 同路最终框（含弱框）再 IoU 合并：OUTPUT_LAYER_NMS_IOU=0.42，OUTPUT_LAYER_NMS=0 关闭
# 上下半幅错位检测（易误判天空/地面，默认关）：RTSP_FRAME_SLICE_CHECK=1
# RTSP_FRAME_SLICE_CORR_MIN=0.18
# ffmpeg 二次尝试：RTSP_FFMPEG_NOKEY_FALLBACK=1（nokey 失败或不通过花屏检测时再抽一帧）
# 先 TCP DESCRIBE 探测，仅非 404 再走 OpenCV（与 Next 一致，可用毫秒）
# RTSP_DESCRIBE_TIMEOUT_MS=2500
# RTSP_DESCRIBE_TIMEOUT_SEC=2.5
# 若服务端对 DESCRIBE 不兼容可关闭：SKIP_RTSP_DESCRIBE_PROBE=1
# DETECTIONS_STATS=1 时在 JSON 中带 stats，便于排查有流无框
# DETECTIONS_STATS=1
# 识别帧 JPEG 质量（供 /preview/<id>，默认 72）
# DETECTION_PREVIEW_JPEG_QUALITY=72
# 误检多 / 不同人 ID 全并成一个：可调 YOLO_KEEP_MIN_CONF、PERSON_AR_*、REID_MATCH_THRESHOLD、REID_MIN_MARGIN（见 person_filters.py / gallery_store.py）
# 紧急排查「有 YOLO 无框」可临时 PERSON_USE_SHAPE_FILTER=0 或 PERSON_USE_CONF_FILTER=0
# YOLO_KEEP_MIN_CONF=0.22
# REID_MATCH_THRESHOLD=0.60
# 画廊每人多原型（背面/侧面等）：REID_PROTOTYPES_PER_PERSON=5，与最像原型余弦低于 REID_APPEND_PROTO_IF_MAX_SIM_BELOW 时追加一条
# REID_PROTOTYPES_PER_PERSON=5
# REID_APPEND_PROTO_IF_MAX_SIM_BELOW=0.78
# REID_MIN_MARGIN=0.03
# REID_SINGLETON_EXTRA_SIM=0.02
# REID_MULTI_PROTO_RELAX=0.04
# REID_HIGH_CONF_MATCH_SIM=0.72
# 同一次采样内跨摄像头互为最近邻先聚类，提升重叠/相邻视角下同人合并
# REID_TICK_CLUSTER=1
# REID_TICK_CLUSTER_THRESHOLD=0.54
# REID_TICK_CLUSTER_MIN_MARGIN=0.02
# REID_TICK_CLUSTER_HIGH_SIM=0.68
# REID_TICK_CLUSTER_EXISTING_SIM=0.58
# REID_TICK_CLUSTER_EXISTING_STRONG_SIM=0.70
# 同一路同一帧：两框 IoU 低于 REID_SAME_FRAME_MAX_IOU_SAME_PERSON（默认 0.38）却共用同一 ID 时，对低置信框强制新开 ID
# REID_SAME_FRAME_IOU_SPLIT=1
# REID_SAME_FRAME_MAX_IOU_SAME_PERSON=0.38
# —— 每路轨迹（跨采样复用 global id，防同一人刷成几百个画廊 id；关 REID_PER_CAMERA_TRACK=0 退回旧逻辑）
# REID_PER_CAMERA_TRACK=1
# 同一次 /detections 内全路强检框排序后再进画廊，减轻「先跑的路抢占 id」导致跨镜同人多 id（关 REID_GLOBAL_MATCH_ORDER=0）
# REID_GLOBAL_MATCH_ORDER=1
# TRACK_MATCH_MIN_SCORE=0.40
# TRACK_MATCH_IOU_W=0.22
# TRACK_MATCH_COS_W=0.58
# TRACK_MATCH_CENTER_W=0.20
# TRACK_CENTER_SHARP=2.5
# TRACK_FEAT_LOCAL_EMA=0.28
# TRACK_MAX_MISSED=8
# 离开画面后保留「休眠」条数上限（FIFO 淘汰最旧）
# TRACK_DORMANT_MAX=96
# 休眠超过该秒数丢弃（0=不按时间淘汰，只靠条数上限）
# TRACK_DORMANT_TTL_SEC=0
# 再入画与休眠匹配：阈值通常低于 TRACK_MATCH_MIN_SCORE，偏靠外观
# TRACK_DORMANT_MATCH_MIN_SCORE=0.30
# TRACK_DORMANT_IOU_W=0.08
# TRACK_DORMANT_COS_W=0.82
# TRACK_DORMANT_CENTER_W=0.10
# TRACK_DORMANT_CENTER_SHARP=0.35
# —— 侧向/背面：① 水平翻转 TTA（默认开）② 画廊用 max(原,镜像) 与模板比（更稳，CPU 仍一次 batch）③ 换 torchreid+OSNet-AIN+MSMT17 权重
# REID_TTA_HORIZONTAL=1
# REID_GALLERY_MAX_TTA=1
# REID_EMBED_BACKEND=fastreid
# REID_EMBED_BACKEND=torchreid
# TORCHREID_MODEL=osnet_ain_x1_0
# TORCHREID_WEIGHTS=/path/to/osnet_ain_x1_0_msmt17.pth.tar
# TORCHREID_DEVICE=cpu
REID_BIND_HOST=0.0.0.0
REID_BIND_PORT=8890

# —— 以下变量写在「项目根」.env.local（Next 读），用于 /api/rtsp 转 MJPEG，与 backend/.env 无关
# RTSP_FFMPEG_HWACCEL=videotoolbox
# RTSP_FFMPEG_PROBESIZE=10M
# RTSP_FFMPEG_ANALYZEDURATION=10M
# RTSP_FFMPEG_MAX_DELAY_US=8000000
# RTSP_MJPEG_Q=6
